  "vision": {
    "summary": "The goal of this project is to create a fully offline-capable desktop AI assistant that behaves like a real personal assistant instead of a simple chatbot. The assistant should understand voice and text commands, control the operating system, automate repetitive tasks, maintain memory, search the internet when necessary, interact naturally with the user, and intelligently decide which AI model or service should be used depending on the situation."
  },

  "primary_objectives": [
    "Act as a real desktop personal assistant.",
    "Support both voice and text conversations.",
    "Operate completely offline for local tasks.",
    "Automatically switch to online services when internet access is available.",
    "Perform desktop automation without requiring continuous user interaction.",
    "Understand goals instead of only predefined commands.",
    "Be modular and expandable through plugins."
  ],

  "core_principles": {
    "offline_first": true,
    "privacy_first": true,
    "cross_platform": true,
    "modular_architecture": true,
    "plugin_based": true,
    "ai_independent": true,
    "voice_first": true,
    "human_like_interaction": true
  },

